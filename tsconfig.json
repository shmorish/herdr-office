{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "allowJs": true,
    "checkJs": false,
    "paths": { "herdr": ["./types/herdr.d.ts"] }
  },
  "include": ["mods/**/*.ts", "types/*.d.ts"]
}
